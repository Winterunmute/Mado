{
  "name": "mado",
  "version": "1.0.0",
  "description": "Mado (窓) - Your window to the world. A personal desktop app combining RSS feeds, YouTube, Reddit and Facebook Messenger.",
  "author": "Rickard Borchers",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "test": "npm run build:electron && node --test tests/*.test.mjs",
    "verify:electron": "electron scripts/verify-electron.mjs",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.electron-preload.json && node scripts/copy-preloads.mjs && node scripts/copy-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "date-fns": "^3.6.0",
    "electron-store": "^10.0.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.441.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.11.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mado.desktop",
    "productName": "Mado",
    "copyright": "Copyright © 2026 Mado",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "extraMetadata": {
      "version": "1.0.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Mado-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mado",
      "installerIcon": "assets/icon-small.ico",
      "uninstallerIcon": "assets/icon-small.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
